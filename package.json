{
  "name": "its-webportal",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "start": "npx tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts"
